# Copy to .env.local and fill in. NEXT_PUBLIC_* values are public (inlined into the client bundle).
# Leaving a social link empty hides that icon.

# Email address (used for mailto: links and as the contact form recipient), e.g. you@example.com
NEXT_PUBLIC_GMAIL_LINK=

# Full profile URLs
NEXT_PUBLIC_SOCIAL_GITHUB_LINK=
NEXT_PUBLIC_SOCIAL_UPWORK_LINK=
NEXT_PUBLIC_SOCIAL_FACEBOOK_LINK=
NEXT_PUBLIC_SOCIAL_LINKEDIN_LINK=

# Server-only secret for the contact form (https://resend.com/api-keys).
# Without a verified domain, Resend only delivers to the email you signed up with,
# so NEXT_PUBLIC_GMAIL_LINK must be that same address.
RESEND_API_KEY=

# Public URL of the site, used for share previews, the sitemap and canonical links,
# e.g. https://jhondelcaranay.com. Optional on Vercel (falls back to the production URL).
NEXT_PUBLIC_SITE_URL=
